# Configuración local de forja. Copia este archivo a .env y cambia lo que necesites.
# .env NO se sube a GitHub (está en .gitignore). Sin .env, todo funciona con los valores de abajo.
# Las variables de entorno del sistema ganan sobre .env.

# Navegador para las revisiones con Playwright (revisar_movil, revisar_ilustraciones, probar_guia).
# Vacío: busca google-chrome o chromium en el PATH y, si no hay, usa el Chromium de Playwright.
FORJA_NAVEGADOR=

# Carpeta donde se guardan capturas e informes de las revisiones (una subcarpeta por guía).
# Vacío: la carpeta temporal del sistema (/tmp en Linux y macOS).
FORJA_SALIDA=

# Ancho del celular para las revisiones, en px.
FORJA_ANCHO_MOVIL=390

# Si algún día un script necesita una credencial (por ejemplo, un token para publicar),
# va aquí y nunca en el código ni en un commit:
# GITHUB_TOKEN=
